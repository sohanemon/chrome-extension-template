{
	"manifest_version": 3,
	"name": "Chrome Extension Template",
	"version": "1.0.0",
	"description": "",
	"action": {
		"default_popup": "index.html"
	},
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["content.js"],
			"run_at": "document_idle"
		}
	],
	"permissions": ["activeTab", "scripting", "downloads"],
	"web_accessible_resources": [
		{
			"resources": ["content.js"],
			"matches": ["<all_urls>"]
		}
	]
}
